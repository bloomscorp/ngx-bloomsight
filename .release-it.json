{
    "hooks": {
        "before:init": [
            "git pull"
        ],
        "after:bump": [
            "npm run sync-version",
            "npm run build-lib",
            "git add projects/bloomscorp/ngx-bloomsight/package.json"
        ]
    },
    "git": {
        "commitMessage": "chore: release v${version}",
        "tagName": "v${version}",
        "requireBranch": "main",
        "requireUpstream": false,
        "requireCleanWorkingDir": true,
        "push": true
    },
    "github": {
        "release": false,
        "host": "github.com"
    },
    "npm": {
        "publish": false
    },
    "plugins": {
        "@release-it/conventional-changelog": {
            "infile": "CHANGELOG.md",
            "preset": {
                "name": "angular",
                "types": [
                    {
                        "type": "feat",
                        "section": "Features"
                    },
                    {
                        "type": "fix",
                        "section": "Bug Fixes"
                    },
                    {
                        "type": "docs",
                        "section": "Documentation"
                    },
                    {
                        "type": "perf",
                        "section": "Performance Improvements"
                    },
                    {
                        "type": "build",
                        "section": "Build"
                    }
                ]
            }
        }
    }
}
